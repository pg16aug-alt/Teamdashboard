{
  "name": "team-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:rules": "firebase emulators:exec --only firestore --project demo-teamdashboard \"tsx --test tests/rules.test.ts\"",
    "dev:emulator": "NEXT_PUBLIC_USE_EMULATOR=1 NEXT_PUBLIC_FIREBASE_API_KEY=demo NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=localhost NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-teamdashboard NEXT_PUBLIC_FIREBASE_APP_ID=demo next dev -p 3100",
    "test:e2e": "firebase emulators:exec --only auth,firestore --project demo-teamdashboard \"node tests/e2e.mjs\"",
    "test": "npm run test:rules"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "firebase": "^12.19.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.1.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "firebase-tools": "^15.34.0",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.0"
  }
}
